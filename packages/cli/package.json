{
  "name": "vorlyn",
  "version": "0.3.0",
  "type": "module",
  "bin": {
    "vorlyn": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "registry"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vorlyn/vorlyn.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate-registry": "tsx scripts/generate-registry.ts",
    "prepublishOnly": "pnpm generate-registry && pnpm build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/prompts": "^2.4.9",
    "eslint": "^9.39.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
